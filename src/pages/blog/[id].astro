---
import { createClient } from "microcms-js-sdk";
import "../../styles/global.css";

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

export async function getStaticPaths() {
  const client = createClient({
    serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
    apiKey: import.meta.env.MICROCMS_API_KEY,
  });

  const data = await client.getList({
    endpoint: "blogs",
  });

  return data.contents.map((content) => ({
    params: { id: content.id },
  }));
}

const { id } = Astro.params;

const blog = await client.getListDetail({
  endpoint: "blogs",
  contentId: id,
});

// 本文からHTMLタグを除去してメタディスクリプション用の要約（120文字）を作成
const plainDescription = blog.content
  ? blog.content.replace(/<[^>]+>/g, "").slice(0, 120) + "..."
  : "テックブログの記事詳細ページです。";

// ページの完全なURL（Cloudflare Pagesのドメインに合わせて設定）
const siteUrl = "https://my-tech-media.pages.dev";
const pageUrl = `${siteUrl}/blog/${blog.id}`;
const ogImage = blog.eyecatch ? blog.eyecatch.url : `${siteUrl}/favicon.svg`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{blog.title} | Tech Media</title>
    <meta name="description" content={plainDescription} />

    <!-- OGP (Open Graph Protocol) 基本設定 -->
    <meta property="og:title" content={blog.title} />
    <meta property="og:description" content={plainDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Tech Media" />

    <!-- Twitter / X カード設定（大きな画像カード形式） -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={blog.title} />
    <meta name="twitter:description" content={plainDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-gray-50 text-gray-800 antialiased min-h-screen py-10 px-4">
    <div class="max-w-3xl mx-auto bg-white p-6 md:p-10 rounded-2xl shadow-sm border border-gray-100">
      
      <!-- 戻るリンク -->
      <a href="/" class="text-sm font-medium text-blue-600 hover:underline inline-block mb-6">
        ← 記事一覧に戻る
      </a>

      <!-- メタ情報（カテゴリ & 公開日） -->
      <div class="flex items-center gap-3 mb-4 text-xs font-semibold">
        {blog.category && (
          <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full">
            {blog.category.name}
          </span>
        )}
        <time class="text-gray-400">
          {new Date(blog.publishedAt).toLocaleDateString("ja-JP")}
        </time>
      </div>

      <!-- タイトル -->
      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight mb-6">
        {blog.title}
      </h1>

      <!-- アイキャッチ画像 -->
      {blog.eyecatch && (
        <div class="mb-8 overflow-hidden rounded-xl">
          <img 
            src={blog.eyecatch.url} 
            alt={blog.title} 
            class="w-full h-auto object-cover" 
          />
        </div>
      )}

      <!-- 記事本文（proseクラスで記事全体を一括スタイリング） -->
      <div class="prose prose-lg max-w-none prose-blue prose-pre:bg-gray-900 prose-pre:text-gray-100" set:html={blog.content} />
      
    </div>
  </body>
</html>