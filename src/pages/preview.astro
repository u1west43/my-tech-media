---
// src/pages/preview.astro
import BaseLayout from '../layouts/BaseLayout.astro'; // お使いのレイアウト
import { createClient } from 'microcms-js-sdk';

// URLパラメータから contentId と draftKey を取得
const contentId = Astro.url.searchParams.get('contentId');
const draftKey = Astro.url.searchParams.get('draftKey');

if (!contentId || !draftKey) {
  return new Response('パラメータ（contentId または draftKey）が不足しています。', { status: 400 });
}

// microCMSクライアントの初期化（環境変数を使用）
const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

let post;
try {
  // draftKey を渡して下書き記事を取得
  post = await client.get({
    endpoint: 'blog', // ご自身のAPIエンドポイント名
    contentId: contentId,
    queries: { draftKey: draftKey },
  });
} catch (error) {
  return new Response('記事の取得に失敗しました。', { status: 404 });
}
---

<BaseLayout title={`[下書き] ${post.title}`}>
  <article style="max-width: 800px; margin: 0 auto; padding: 2rem;">
    <div style="background: #fff3cd; color: #856404; padding: 10px; border-radius: 4px; margin-bottom: 20px;">
      ⚠️ 現在はプレビュー（下書き）モードで表示しています。
    </div>
    <h1>{post.title}</h1>
    <div set:html={post.content} />
  </article>
</BaseLayout>