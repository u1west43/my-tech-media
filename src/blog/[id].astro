---
import { createClient } from "microcms-js-sdk";

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

export async function getStaticPaths() {
  const client = createClient({
    serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
    apiKey: import.meta.env.MICROCMS_API_KEY,
  });
  const data = await client.getList({
    endpoint: "blogs",
  });

  return data.contents.map((content) => ({
    params: { id: content.id },
  }));
}

const { id } = Astro.params;

const blog = await client.getListDetail({
  endpoint: "blogs",
  contentId: id,
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{blog.title} | マイ・テックメディア</title>
    <style>
      body {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.8;
        color: #333;
      }
      .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        color: #0070f3;
        text-decoration: none;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      .title {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        line-height: 1.3;
      }
      .date {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 2rem;
      }
      .content {
        border-top: 1px solid #eee;
        padding-top: 2rem;
      }
      .content img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <a href="/" class="back-link">← 記事一覧に戻る</a>
    <article>
      <h1 class="title">{blog.title}</h1>
      <p class="date">公開日: {new Date(blog.publishedAt).toLocaleDateString("ja-JP")}</p>
      <div class="content" set:html={blog.content} />
    </article>
  </body>
</html>