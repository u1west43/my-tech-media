---
import { createClient } from "microcms-js-sdk";

// microCMS繧ｯ繝ｩ繧､繧｢繝ｳ繝医・蛻晄悄蛹・const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

// 險倅ｺ九ョ繝ｼ繧ｿ縺ｮ蝙句ｮ夂ｾｩ
type Blog = {
  id: string;
  title: string;
  content: string;
  publishedAt: string;
};

// microCMS縺九ｉ縲恵logs縲阪・繝・・繧ｿ繧貞叙蠕・const response = await client.get<{ contents: Blog[] }>({
  endpoint: "blogs",
});
const posts = response.contents;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>繝槭う繝ｻ繝・ャ繧ｯ繝｡繝・ぅ繧｢</title>
  </head>
  <body>
    <main style="max-width: 800px; margin: 40px auto; padding: 0 20px; font-family: sans-serif;">
      <h1>噫 繝槭う繝ｻ繝・ャ繧ｯ繝｡繝・ぅ繧｢</h1>
      <p>microCMS ・・Astro 縺ｫ繧医ｋ辷・溯・蜍募喧繝｡繝・ぅ繧｢縺ｸ繧医≧縺薙◎縲・/p>
      
      <hr style="margin: 20px 0; border: none; border-top: 1px solid #ddd;" />

      <h2>險倅ｺ倶ｸ隕ｧ</h2>
      <ul style="list-style: none; padding: 0;">
        {
          posts.map((post) => (
            <li style="margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #f0f0f0;">
              <h3 style="margin: 0 0 6px 0;">
                <a
                  href={`/blog/${post.id}`}
                  style="color: #0070f3; text-decoration: none; font-size: 1.2rem;"
                >
                  {post.title}
                </a>
              </h3>
              <small style="color: #666;">
                蜈ｬ髢区律: {new Date(post.publishedAt).toLocaleDateString("ja-JP")}
              </small>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
