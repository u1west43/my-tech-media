---
// src/pages/index.astro
import { createClient } from "microcms-js-sdk";
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

// 全記事を公開日順（新しい順）で取得
let allContents: any[] = [];
let offset = 0;
const limit = 100;
let totalCount = 0;

do {
  const res = await client.getList({
    endpoint: "blogs",
    queries: { offset, limit, orders: "-publishedAt" },
  });
  allContents = [...allContents, ...res.contents];
  totalCount = res.totalCount;
  offset += limit;
} while (allContents.length < totalCount);

// トップページ1ページ目に表示する最新12件
const POSTS_PER_PAGE = 12;
const latestPosts = allContents.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(allContents.length / POSTS_PER_PAGE);

// 「初めての方へ」固定ピックアップ記事（総集編・構築ロードマップ・VPS比較）
const pickupSlugs = [
  "ai-automated-media-architecture-roadmap",
  "astro-microcms-cloudflare",
  "recommended-vps-for-automation",
];
const featuredPosts = pickupSlugs
  .map((slug) => allContents.find((post) => post.id === slug))
  .filter(Boolean);

// 画像URLをWebP＆最適サイズに変換するヘルパー関数
const optimizeThumb = (url?: string, width = 640) => {
  if (!url) return "/favicon.svg";
  if (!url.includes("microcms-assets.io")) return url;
  const sep = url.includes("?") ? "&" : "?";
  return `${url}${sep}fm=webp&w=${width}&q=80&fit=max`;
};

const siteTitle = "Core Media Lab | AI・自動化で個人メディア運営を省力化する実践技術ラボ";
const siteDesc =
  "Astro・microCMS・Cloudflare Pagesによる高速メディア構築から、GAS・Python・VPS（Dify/n8n）を活用した24時間自動化まで、実機検証に基づく構築手順と運営ノウハウを発信する専門技術メディアです。";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDesc} />
    <link rel="canonical" href="https://coremedialab.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://coremedialab.com/" />
  </head>

  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <!-- 1. ヘッダー＆グローバルナビゲーション（審査で重要なカテゴリ・運営者導線） -->
    <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 text-xl font-extrabold tracking-tight hover:opacity-90 transition">
          <span class="bg-sky-500 text-slate-950 font-black px-2 py-0.5 rounded text-base">&gt;_</span>
          <span>Core Media Lab</span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-200">
          <a href="/category/tech" class="hover:text-sky-400 transition">開発・インフラ</a>
          <a href="/category/headless-cms" class="hover:text-sky-400 transition">ヘッドレスCMS</a>
          <a href="/category/automation" class="hover:text-sky-400 transition">自動化・ツール</a>
          <a href="/category/operations" class="hover:text-sky-400 transition">サイト運営・分析</a>
          <a href="/about" class="text-slate-300 hover:text-white border-l border-slate-700 pl-6 transition">運営者情報</a>
        </nav>
      </div>
    </header>

    <!-- 2. ヒーローセクション＆初めての方へ（厳選ロードマップ3選） -->
    <section class="bg-gradient-to-b from-slate-900 via-slate-900 to-slate-800 text-white py-10 border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-3xl mb-8">
          <span class="inline-block bg-sky-500/20 text-sky-300 border border-sky-500/30 text-xs font-bold px-3 py-1 rounded-full mb-3">
            個人開発 × AI・自動化 実践ラボ
          </span>
          <h1 class="text-2xl md:text-3xl font-extrabold leading-tight mb-3">
            テクノロジーと自動化で、個人のWebメディア運営を極限まで省力化する。
          </h1>
          <p class="text-slate-300 text-sm md:text-base leading-relaxed">
            Core Media Labは、維持費0円の高速フロントエンド（Astro × microCMS × Cloudflare）と、24時間稼働の自動化基盤（GAS・Python・VPS上のDify / n8n）を実機検証し、再現可能なコードと手順を体系化した技術メディアです。
          </p>
        </div>

        {featuredPosts.length > 0 && (
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-3 flex items-center gap-1.5">
              <span>★</span> 初めての方におすすめの全体設計・必読ガイド（3選）
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {featuredPosts.map((post, idx) => (
                <a
                  href={`/blog/${post.id}`}
                  class="group bg-slate-800/90 hover:bg-slate-800 border border-slate-700 hover:border-sky-500/60 rounded-xl overflow-hidden flex flex-col transition-all duration-200 shadow-lg"
                >
                  <div class="aspect-video w-full bg-slate-950 overflow-hidden relative">
                    <img
                      src={optimizeThumb(post.eyecatch?.url, 640)}
                      alt={post.title}
                      width="640"
                      height="360"
                      loading={idx === 0 ? "eager" : "lazy"}
                      fetchpriority={idx === 0 ? "high" : "auto"}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                    <span class="absolute top-2 left-2 bg-amber-500 text-slate-950 text-xs font-extrabold px-2.5 py-0.5 rounded shadow">
                      必読 Step {idx + 1}
                    </span>
                  </div>
                  <div class="p-4 flex-1 flex flex-col justify-between">
                    <h3 class="text-sm font-bold text-white group-hover:text-sky-300 transition-colors line-clamp-2 leading-snug">
                      {post.title}
                    </h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- スマホ用カテゴリクイックリンク -->
    <div class="md:hidden bg-white border-b border-slate-200 px-4 py-2.5 overflow-x-auto">
      <div class="flex items-center gap-2 text-xs font-bold whitespace-nowrap">
        <a href="/category/tech" class="px-3 py-1.5 bg-slate-100 text-slate-700 rounded-full">開発・インフラ</a>
        <a href="/category/headless-cms" class="px-3 py-1.5 bg-slate-100 text-slate-700 rounded-full">ヘッドレスCMS</a>
        <a href="/category/automation" class="px-3 py-1.5 bg-slate-100 text-slate-700 rounded-full">自動化・ツール</a>
        <a href="/category/operations" class="px-3 py-1.5 bg-slate-100 text-slate-700 rounded-full">サイト運営・分析</a>
      </div>
    </div>

    <!-- 3. メインコンテンツ（2カラム：左＝最新記事一覧、右＝追従サイドバー） -->
    <main class="max-w-6xl mx-auto px-4 py-10 flex-1 w-full">
      <div class="flex flex-col lg:flex-row items-start gap-8">
        <!-- 左カラム：新着記事一覧 -->
        <div class="w-full flex-1">
          <div class="flex items-center justify-between mb-6 pb-3 border-b-2 border-slate-200">
            <h2 class="text-xl font-extrabold text-slate-900 flex items-center gap-2">
              <span class="w-2 h-6 bg-sky-600 rounded-sm inline-block"></span>
              新着の実践技術記事
            </h2>
            <span class="text-xs font-semibold text-slate-500">
              全 {totalCount} 件中 1〜{latestPosts.length} 件を表示
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {latestPosts.map((blog) => (
              <article class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 flex flex-col">
                <a href={`/blog/${blog.id}`} class="aspect-video w-full bg-slate-100 overflow-hidden relative block group">
                  <img
                    src={optimizeThumb(blog.eyecatch?.url, 600)}
                    alt={blog.title}
                    width="600"
                    height="338"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </a>

                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2.5">
                      {blog.category?.id ? (
                        <a
                          href={`/category/${blog.category.id}`}
                          class="text-xs font-bold text-sky-700 bg-sky-50 hover:bg-sky-100 border border-sky-200 px-2.5 py-0.5 rounded transition"
                        >
                          {blog.category.name || blog.category.id}
                        </a>
                      ) : (
                        <span class="text-xs font-bold text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded">
                          技術記事
                        </span>
                      )}
                      <time datetime={blog.publishedAt} class="text-xs text-slate-400 font-medium">
                        {new Date(blog.publishedAt).toLocaleDateString("ja-JP")}
                      </time>
                    </div>

                    <h3 class="text-base font-bold text-slate-900 leading-snug mb-2 line-clamp-2">
                      <a href={`/blog/${blog.id}`} class="hover:text-sky-600 transition-colors">
                        {blog.title}
                      </a>
                    </h3>

                    {blog.description && (
                      <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-3">
                        {blog.description}
                      </p>
                    )}
                  </div>

                  <div class="pt-3 border-t border-slate-100 flex justify-end">
                    <a
                      href={`/blog/${blog.id}`}
                      class="text-xs font-bold text-sky-600 hover:text-sky-700 inline-flex items-center gap-1"
                    >
                      記事を読む <span>→</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- ページネーション導線 -->
          {totalPages > 1 && (
            <nav class="mt-10 flex items-center justify-center gap-2" aria-label="ページネーション">
              <span class="px-4 py-2 rounded-lg bg-sky-600 text-white text-sm font-bold shadow-sm">
                1
              </span>
              {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNum) => (
                <a
                  href={`/page/${pageNum}`}
                  class="px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 text-sm font-bold transition"
                >
                  {pageNum}
                </a>
              ))}
              <a
                href="/page/2"
                class="px-4 py-2 rounded-lg bg-white border border-slate-200 text-sky-600 hover:bg-sky-50 text-sm font-bold transition ml-2"
              >
                次のページ →
              </a>
            </nav>
          )}
        </div>

        <!-- 右カラム：共通追従サイドバー -->
        <Sidebar />
      </div>
    </main>

    <!-- 4. フッター（AdSense審査必須の固定ページリンクを完備） -->
    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 py-10 mt-16">
      <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <p class="text-white font-bold text-base mb-1">Core Media Lab</p>
          <p class="text-xs text-slate-400">
            AI・自動化を活用した個人向けWebサイト運営・効率化メディア
          </p>
        </div>

        <nav class="flex flex-wrap items-center justify-center gap-6 text-xs font-medium">
          <a href="/" class="hover:text-white transition">ホーム</a>
          <a href="/about" class="hover:text-white transition">運営者情報・プロフィール</a>
          <a href="/privacy" class="hover:text-white transition">プライバシーポリシー・免責事項</a>
          <a href="/contact" class="hover:text-white transition">お問い合わせ</a>
          <a href="/sitemap-index.xml" class="hover:text-white transition">サイトマップ</a>
        </nav>
      </div>
      <div class="max-w-6xl mx-auto px-4 mt-6 pt-6 border-t border-slate-800 text-center text-xs text-slate-500">
        &copy; {new Date().getFullYear()} Core Media Lab. All rights reserved.
      </div>
    </footer>
  </body>
</html>