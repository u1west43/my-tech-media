---
import { createClient } from "microcms-js-sdk";
import "../styles/global.css";

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

// microCMSから最新記事一覧を取得
const data = await client.getList({
  endpoint: "blogs",
  queries: {
    orders: "-publishedAt",
  },
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>マイ・テックメディア</title>
  </head>
  <body class="bg-gray-50 text-gray-800 antialiased min-h-screen py-10 px-4">
    <main class="max-w-5xl mx-auto">
      
      <!-- サイトヘッダー -->
      <header class="mb-12 text-center md:text-left">
        <h1 class="text-3xl md:text-5xl font-black text-gray-900 tracking-tight mb-2">
          Tech Media
        </h1>
        <p class="text-gray-500 text-sm md:text-base">
          モダンフロントエンド・ヘッドレスCMS・自動化ノウハウを発信する技術ブログ
        </p>
      </header>

      <!-- 記事カード一覧（グリッド表示） -->
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          data.contents.map((blog) => (
            <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 border border-gray-100 flex flex-col">
              <a href={`/blog/${blog.id}`} class="block overflow-hidden aspect-video bg-gray-100">
                {blog.eyecatch ? (
                  <img
                    src={blog.eyecatch.url}
                    alt={blog.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-400 text-xs">
                    No Image
                  </div>
                )}
              </a>

              <div class="p-5 flex flex-col flex-1">
                <!-- カテゴリ ＆ 日付 -->
                <div class="flex items-center gap-2 mb-3 text-xs font-semibold">
                  {blog.category && (
                    <span class="bg-blue-100 text-blue-700 px-2.5 py-0.5 rounded-full">
                      {blog.category.name}
                    </span>
                  )}
                  <time class="text-gray-400">
                    {new Date(blog.publishedAt).toLocaleDateString("ja-JP")}
                  </time>
                </div>

                <!-- 記事タイトル -->
                <h2 class="text-lg font-bold text-gray-900 leading-snug mb-3 hover:text-blue-600 transition-colors">
                  <a href={`/blog/${blog.id}`}>{blog.title}</a>
                </h2>

                <div class="mt-auto pt-3">
                  <a
                    href={`/blog/${blog.id}`}
                    class="text-xs font-semibold text-blue-600 hover:underline inline-flex items-center gap-1"
                  >
                    記事を読む →
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </section>

    </main>
  </body>
</html>