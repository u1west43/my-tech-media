---
import { createClient } from "microcms-js-sdk";
import AuthorProfile from "../../components/AuthorProfile.astro";
import "../../styles/global.css";

const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

export async function getStaticPaths() {
  const client = createClient({
    serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
    apiKey: import.meta.env.MICROCMS_API_KEY,
  });

  let allContents: any[] = [];
  let offset = 0;
  const limit = 100;
  let totalCount = 0;

  do {
    const data = await client.getList({
      endpoint: "blogs",
      queries: { offset, limit },
    });
    allContents = [...allContents, ...data.contents];
    totalCount = data.totalCount;
    offset += limit;
  } while (allContents.length < totalCount);

  return allContents.map((content) => ({
    params: { id: content.id },
  }));
}

const { id } = Astro.params;

const blog = await client.getListDetail({
  endpoint: "blogs",
  contentId: id,
});

const plainDescription = blog.content
  ? blog.content.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim().slice(0, 120) + "..."
  : "Core Media Labの技術記事詳細ページです。";

const siteUrl = "[https://coremedialab.com](https://coremedialab.com)";
const pageUrl = `${siteUrl}/blog/${blog.id}`;
const ogImage = blog.eyecatch ? blog.eyecatch.url : `${siteUrl}/favicon.svg`;
---

<!doctype html>
<html lang="ja">
  <head>
    <!-- Google AdSense 審査用コード -->
    <script async src="[https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3860499997960561](https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3860499997960561)" crossorigin="anonymous"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="[https://www.googletagmanager.com/gtag/js?id=G-P4W05TS6HJ](https://www.googletagmanager.com/gtag/js?id=G-P4W05TS6HJ)"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P4W05TS6HJ');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{blog.title} | Core Media Lab</title>
    <meta name="description" content={plainDescription} />
    <link rel="canonical" href={pageUrl} />

    <!-- OGP 設定 -->
    <meta property="og:title" content={blog.title} />
    <meta property="og:description" content={plainDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Core Media Lab" />

    <!-- Twitter カード -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={blog.title} />
    <meta name="twitter:description" content={plainDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-gray-50 text-gray-800 antialiased min-h-screen flex flex-col justify-between">
    
    <!-- サイト共通ヘッダーバー -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="!text-lg !font-bold !text-gray-900 !no-underline hover:!text-blue-600 transition-colors">
          Core Media Lab
        </a>
        <a href="/" class="!text-xs !font-semibold !text-gray-500 hover:!text-blue-600 !no-underline">
          記事一覧
        </a>
      </div>
    </header>

    <!-- 記事メインコンテナ -->
    <main class="max-w-4xl w-full mx-auto px-4 py-8 md:py-12">
      <article class="bg-white p-6 md:p-12 rounded-2xl shadow-sm border border-gray-100">
        
        <!-- メタ情報（カテゴリ & 公開日） -->
        <div class="flex items-center gap-2 mb-4 text-xs font-semibold">
          {blog.category && (
            <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full">
              {blog.category.name}
            </span>
          )}
          <time class="text-gray-400">
            {new Date(blog.publishedAt).toLocaleDateString("ja-JP")}
          </time>
        </div>

        <!-- 記事タイトル -->
        <h1 class="!text-2xl md:!text-3xl !font-bold !text-gray-900 !leading-snug !mb-6 !tracking-tight">
          {blog.title}
        </h1>

        <!-- アイキャッチ画像 -->
        {blog.eyecatch && (
          <div class="mb-10 overflow-hidden rounded-xl border border-gray-100">
            <img 
              src={blog.eyecatch.url} 
              alt={blog.title} 
              class="w-full h-auto object-cover max-h-[420px]" 
            />
          </div>
        )}

        <!-- 記事本文 -->
        <div 
          class="prose max-w-none text-gray-700 leading-relaxed
                 prose-headings:!font-bold prose-headings:!text-gray-900
                 prose-h2:!text-xl md:prose-h2:!text-2xl prose-h2:!border-b prose-h2:!border-gray-200 prose-h2:!pb-2 prose-h2:!mt-10 prose-h2:!mb-4
                 prose-h3:!text-lg md:prose-h3:!text-xl prose-h3:!mt-8 prose-h3:!mb-3
                 prose-p:!text-sm md:prose-p:!text-base prose-p:!leading-loose prose-p:!mb-5
                 prose-pre:!bg-gray-900 prose-pre:!text-gray-100 prose-pre:!rounded-xl prose-pre:!p-4
                 prose-code:!text-xs md:prose-code:!text-sm
                 prose-a:!text-blue-600 prose-a:!underline hover:prose-a:!text-blue-800" 
          set:html={blog.content} 
        />

        <!-- 著者プロフィール（共通コンポーネント） -->
        <AuthorProfile />
        
        <!-- 記事下部ナビゲーション -->
        <div class="mt-10 pt-6 border-t border-gray-100 text-center">
          <a href="/" class="!text-sm !font-semibold !text-blue-600 hover:!underline">
            ← トップページ（記事一覧）へ戻る
          </a>
        </div>

      </article>
    </main>

    <!-- サイト共通フッター -->
    <footer class="mt-12 py-8 border-t border-gray-200 text-center text-xs text-gray-400 bg-white">
      <div class="flex justify-center gap-4 mb-3">
        <a href="/privacy" class="hover:text-gray-600 transition-colors !no-underline">運営者情報・プライバシーポリシー</a>
        <span>•</span>
        <a href="/contact" class="hover:text-gray-600 transition-colors !no-underline">お問い合わせ</a>
      </div>
      <p class="m-0">&copy; {new Date().getFullYear()} Core Media Lab. All rights reserved.</p>
    </footer>

  </body>
</html>