---
const today = new Date();
---

<footer>
  <div class="footer-links">
    <a href="/privacy">運営者情報・プライバシーポリシー</a>
    <a href="/contact">お問い合わせ</a>
  </div>
  <p>&copy; {today.getFullYear()} Core Media Lab. All rights reserved.</p>
</footer>

<style>
  footer {
    padding: 3rem 1rem 2rem;
    color: rgb(var(--gray));
    text-align: center;
    font-size: 0.9rem;
    border-top: 1px solid rgb(var(--gray-light), 0.5);
    margin-top: 3rem;
  }
  .footer-links {
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  footer a {
    color: rgb(var(--gray));
    text-decoration: none;
    transition: color 0.2s ease;
  }
  footer a:hover {
    color: rgb(var(--accent));
    text-decoration: underline;
  }

</style>